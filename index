<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CHUB Fleet Maintenance Hub</title>
    <style>
        body { font-family: sans-serif; background: linear-gradient(135deg, #eef4fa 0%, #f5f7fa 100%); display: flex; align-items: center; justify-content: center; min-height: 100vh; margin: 0; padding: 20px; }
        .hub { background: white; padding: 40px; border-radius: 30px; box-shadow: 0 20px 40px -10px rgba(0,0,0,0.15); text-align: center; max-width: 400px; width: 100%; }
        h1 { color: #0b3b5c; margin-bottom: 30px; font-size: 1.8rem; }
        .btn { display: block; padding: 18px; margin-bottom: 15px; border-radius: 40px; text-decoration: none; font-weight: 700; font-size: 1.1rem; transition: 0.2s; color: white; }
        .btn-gen { background: #1e4a6d; } .btn-gen:hover { background: #0f3852; }
        .btn-ac { background: #2a6b96; } .btn-ac:hover { background: #1e4a6d; }
        .btn-ref { background: #b33a3a; } .btn-ref:hover { background: #8f2929; }
    </style>
</head>
<body>
    <div class="hub">
        <h1>🛠️ CHUB Fleet Hub</h1>
        <a href="YOUR_GENERATOR_URL" class="btn btn-gen">⚡ Generator Maintenance</a>
        <a href="YOUR_AC_URL" class="btn btn-ac">❄️ Air Conditioner Maintenance</a>
        <a href="YOUR_REFRIGERATOR_URL" class="btn btn-ref">🧊 Refrigerator Maintenance</a>
    </div>
</body>
</html>
